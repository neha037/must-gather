#!/bin/bash

# generate /must-gather/version file
. version
echo "openshift/must-gather"> /must-gather/version
version >> /must-gather/version

source $(dirname "$0")/common.sh
source $(dirname "$0")/perf_utils.sh
get_log_collection_args

# Initialise performance tracking
perf_init
perf_start_monitor

# Store PIDs of all the subprocesses
pids=()

# Named resource list, eg. ns/openshift-config
named_resources=()

# Resource groups list, eg. pods
group_resources=()

# Resources to gather with `--all-namespaces` option
all_ns_resources=()

# Cluster Version Information
named_resources+=(ns/openshift-cluster-version)
group_resources+=(clusterversion)

# Operator and APIService Resources
group_resources+=(clusteroperators apiservices)

# Certificate Resources
group_resources+=(certificatesigningrequests)

# Machine/Node Resources
group_resources+=(nodes)

# Namespaces/Project Resources
named_resources+=(ns/default ns/openshift ns/kube-system ns/openshift-etcd)

# Storage Resources
group_resources+=(storageclasses persistentvolumes volumeattachments csidrivers csinodes volumesnapshotclasses volumesnapshotcontents volumegroupsnapshotclasses volumegroupsnapshotcontents clustercsidrivers volumeattributesclasses)
all_ns_resources+=(csistoragecapacities)

# Image-source Resources
group_resources+=(imagecontentsourcepolicies.operator.openshift.io)

# Networking Resources
group_resources+=(networks.operator.openshift.io)

# NodeNetworkState
resources+=(nodenetworkstates nodenetworkconfigurationenactments nodenetworkconfigurationpolicies)

# Assisted Installer
named_resources+=(ns/assisted-installer)

# Leases
all_ns_resources+=(leases)

# Flowcontrol - API Priority and Fairness (APF)
group_resources+=(prioritylevelconfigurations.flowcontrol.apiserver.k8s.io flowschemas.flowcontrol.apiserver.k8s.io)

# ClusterResourceQuota
group_resources+=(clusterresourcequotas.quota.openshift.io)

# Run the Collection of Resources using inspect
# running across all-namespaces for the few "Autoscaler" resources.
oc adm inspect ${log_collection_args} --dest-dir must-gather --rotated-pod-logs "${named_resources[@]}" &
pids+=($!)
perf_track_pid "oc_adm_inspect_named" "$!"

# Parallel resource-existence filter: check all resource types concurrently
# Sanitize resource names (replace / with _) to avoid path issues in temp files
filter_tmpdir=$(mktemp -d)
filter_pids=()
for gr in "${group_resources[@]}"; do
  gr_safe="${gr//\//_}"
  ( oc get "$gr" > /dev/null 2>&1 && echo "$gr" > "$filter_tmpdir/$gr_safe" ) &
  filter_pids+=($!)
done
wait "${filter_pids[@]}"
filtered_group_resources=()
for gr in "${group_resources[@]}"; do
  gr_safe="${gr//\//_}"
  [[ -f "$filter_tmpdir/$gr_safe" ]] && filtered_group_resources+=("$gr")
done
rm -rf "$filter_tmpdir"

# Launch an oc adm inspect for a subset of filtered group resources.
# Skips resources not confirmed to exist on the cluster.
#
# NOTE: This function intentionally modifies the caller's `pids` array and
# calls `perf_track_pid` from the caller's scope. It must NOT be executed
# in a subshell (i.e. do not wrap calls in ( ... ) or pipe into it).
_inspected_resources=()
inspect_group_parallel() {
    # Defensive check: fail if called from a subshell
    if [[ "${BASH_SUBSHELL}" -gt 0 ]]; then
        echo "ERROR: inspect_group_parallel called from subshell - pids array will not be updated" >&2
        return 1
    fi
    local label="$1"
    shift
    local resources=()
    for r in "$@"; do
        for fr in "${filtered_group_resources[@]}"; do
            if [[ "$r" == "$fr" ]]; then
                resources+=("$r")
                break
            fi
        done
    done
    _inspected_resources+=("$@")
    if [[ ${#resources[@]} -eq 0 ]]; then
        return
    fi
    local resources_text
    resources_text=$(IFS=, ; echo "${resources[*]}")
    oc adm inspect ${log_collection_args} --dest-dir must-gather --rotated-pod-logs "${resources_text}" &
    pids+=($!)
    perf_track_pid "$label" "$!"
}

# Split group resources into parallel oc adm inspect calls by weight category.
# Nodes are isolated because they dominate collection time on large clusters.
# Storage resources are grouped together as a mid-weight batch.
# Certs and operators form lighter groups that can finish independently.
#
# IMPORTANT: Every entry in group_resources must appear in exactly one of the
# inspect_group_parallel calls below. The catch-all check after these calls
# will error if any resource is missed.
inspect_group_parallel "oc_adm_inspect_group_nodes" \
    nodes

inspect_group_parallel "oc_adm_inspect_group_storage" \
    storageclasses persistentvolumes volumeattachments \
    csidrivers csinodes volumesnapshotclasses volumesnapshotcontents \
    volumegroupsnapshotclasses volumegroupsnapshotcontents \
    clustercsidrivers volumeattributesclasses

inspect_group_parallel "oc_adm_inspect_group_certs" \
    certificatesigningrequests \
    clusterresourcequotas.quota.openshift.io

inspect_group_parallel "oc_adm_inspect_group_operators" \
    clusterversion clusteroperators apiservices \
    imagecontentsourcepolicies.operator.openshift.io \
    networks.operator.openshift.io \
    prioritylevelconfigurations.flowcontrol.apiserver.k8s.io \
    flowschemas.flowcontrol.apiserver.k8s.io

# Catch-all: verify every group_resource was passed to an inspect_group_parallel
# call. Any resource added to group_resources but not assigned to a parallel
# group would be silently dropped without this guard.
_missed_resources=()
for gr in "${group_resources[@]}"; do
    local_found=false
    for ir in "${_inspected_resources[@]}"; do
        if [[ "$gr" == "$ir" ]]; then
            local_found=true
            break
        fi
    done
    if [[ "$local_found" != "true" ]]; then
        _missed_resources+=("$gr")
    fi
done
if [[ ${#_missed_resources[@]} -gt 0 ]]; then
    echo "WARNING: group_resources not assigned to any inspect_group_parallel call: ${_missed_resources[*]}" >&2
    # Collect the missed resources in a fallback group so nothing is lost
    inspect_group_parallel "oc_adm_inspect_group_uncategorised" "${_missed_resources[@]}"
fi
unset _inspected_resources _missed_resources

all_ns_resources_text=$(IFS=, ; echo "${all_ns_resources[*]}")
oc adm inspect ${log_collection_args} --dest-dir must-gather --rotated-pod-logs "${all_ns_resources_text}" --all-namespaces &
pids+=($!)
perf_track_pid "oc_adm_inspect_all_ns" "$!"

# Gather Insights Operator Archives
perf_track_script "gather_insights" /usr/bin/gather_insights &
pids+=($!)

# Gather monitoring data from the cluster
perf_track_script "gather_monitoring" /usr/bin/gather_monitoring &
pids+=($!)

# Gather optional operator resources from all namespaces
perf_track_script "gather_olm" /usr/bin/gather_olm &
pids+=($!)

# Gather OLM v1 resources
perf_track_script "gather_olm_v1" /usr/bin/gather_olm_v1 &
pids+=($!)

# Gather API Priority and Fairness Endpoints
perf_track_script "gather_priority_and_fairness" /usr/bin/gather_priority_and_fairness &
pids+=($!)

# Gather etcd information
perf_track_script "gather_etcd" /usr/bin/gather_etcd &
pids+=($!)

# Gather Service Logs (using a supplemental Script); Scoped to Masters.
perf_track_script "gather_service_logs" /usr/bin/gather_service_logs master &
pids+=($!)

# Gather Windows Kubernetes component logs
perf_track_script "gather_windows_node_logs" /usr/bin/gather_windows_node_logs &
pids+=($!)

# Gather HAProxy config files
perf_track_script "gather_haproxy_config" /usr/bin/gather_haproxy_config &
pids+=($!)

# Gather kas startup and termination logs
perf_track_script "gather_kas_startup_termination_logs" /usr/bin/gather_kas_startup_termination_logs &
pids+=($!)

# Gather network logs
perf_track_script "gather_network_logs_basics" /usr/bin/gather_network_logs_basics &
pids+=($!)

# Gather metallb logs
perf_track_script "gather_metallb" /usr/bin/gather_metallb &
pids+=($!)

# Gather frr-k8s logs
perf_track_script "gather_frrk8s" /usr/bin/gather_frrk8s &
pids+=($!)

# Gather NMState
perf_track_script "gather_nmstate" /usr/bin/gather_nmstate &
pids+=($!)

# Gather SR-IOV resources
perf_track_script "gather_sriov" /usr/bin/gather_sriov &
pids+=($!)

# Gather PodNetworkConnectivityCheck
perf_track_script "gather_podnetworkconnectivitycheck" /usr/bin/gather_podnetworkconnectivitycheck &
pids+=($!)

# Gather On-Disk MachineConfig files
perf_track_script "gather_machineconfig_ondisk" /usr/bin/gather_machineconfig_ondisk &
pids+=($!)

# Gather On-Disk MachineConfigDaemon logs
perf_track_script "gather_machineconfigdaemon_termination_logs" /usr/bin/gather_machineconfigdaemon_termination_logs &
pids+=($!)

# Gather vSphere resources. This is NOOP on non-vSphere platform.
perf_track_script "gather_vsphere" /usr/bin/gather_vsphere &
pids+=($!)

# Gather Performance profile information
perf_track_script "gather_ppc" /usr/bin/gather_ppc &
pids+=($!)

# Gather OSUS information
perf_track_script "gather_osus" /usr/bin/gather_osus &
pids+=($!)

# Gather Istio/Gateway API information
perf_track_script "gather_istio" /usr/bin/gather_istio &
pids+=($!)

# Check if PID array has any values, if so, wait for them to finish
if [ ${#pids[@]} -ne 0 ]; then
    echo "Waiting on subprocesses to finish execution."
    wait "${pids[@]}"
fi

# Gather ARO information
perf_track_script "gather_aro" /usr/bin/gather_aro

# Stop resource monitor and generate the performance report
perf_stop_monitor
perf_generate_report

# force disk flush to ensure that all data gathered is accessible in the copy container
sync
